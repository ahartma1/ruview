# Production environment for docker-compose.prod.yml.
# Copy to docker/.env.prod and edit, then:
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d --build

# --- Sensing server -----------------------------------------------------

# auto (default) probes UDP 5005 for an ESP32, falling back to simulation.
# Set to "esp32" once your mesh is provisioned, so a dropped node can't
# silently fall back to fake data instead of surfacing an error.
CSI_SOURCE=auto

# Multistatic mesh node positions, "x,y,z;x,y,z;...", one triplet per ESP32
# node in deployment order (meters, arbitrary room-relative origin). Leave
# blank for a single-node deployment.
SENSING_NODE_POSITIONS=

RUST_LOG=info

# Host ports (left side of the docker-compose port mapping). Change these if
# they collide with something else already running on the host.
SENSING_HTTP_PORT=3000
SENSING_WS_PORT=3001
SENSING_UDP_PORT=5005
NVSIM_PORT=7878
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- Resource limits ------------------------------------------------------
# Defaults below assume a host with considerable spare capacity (a
# dedicated Proxmox LXC/VM) but still cap each service so one runaway
# container can't starve the others or the hypervisor. Raise these freely
# if you have more headroom — see docs/deployment/proxmox.md for sizing
# guidance per number of ESP32 nodes / CSI history retained.

SENSING_CPU_LIMIT=4
SENSING_CPU_RESERVATION=1
SENSING_MEM_LIMIT=4g
SENSING_MEM_RESERVATION=512m

NVSIM_CPU_LIMIT=2
NVSIM_CPU_RESERVATION=0.25
NVSIM_MEM_LIMIT=1g
NVSIM_MEM_RESERVATION=128m

PROXY_CPU_LIMIT=1
PROXY_MEM_LIMIT=256m
